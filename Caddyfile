{
	# Quem chega por endereço privado é proxy da própria máquina: o `cloudflared` do túnel ou o
	# docker-proxy. Deles o X-Forwarded-For é mantido; de qualquer outro é sobrescrito com o IP
	# real. Sem isto, atrás do túnel todos os participantes teriam o mesmo IP para a API, e o
	# limite de cadastro por IP bloquearia o estudo.
	servers {
		trusted_proxies static private_ranges
	}
}

# Padrão `:80`, HTTP: o HTTPS fica com a Cloudflare na frente do túnel. O cookie de refresh sai
# `Secure` em produção, o que o navegador aceita em https:// e em http://localhost, nunca em
# http://IP. Para servir HTTPS direto, sem túnel, use um domínio aqui e publique a porta 443.
{$SITE_ADDRESS} {
	encode zstd gzip

	handle /api/* {
		# A documentação da API (Swagger) só pelo localhost do servidor, isto é, pelo túnel SSH.
		# Pelo domínio público a requisição passa pela Cloudflare, que sempre acrescenta
		# `Cf-Connecting-Ip` (o visitante não consegue removê-lo); o `Host` sozinho não basta,
		# porque o nginx da frente pode reescrevê-lo. 404, e não 403, para não confirmar a rota.
		@docsPelaCloudflare {
			path /api/docs /api/docs/* /api/docs-json /api/docs-yaml
			header Cf-Connecting-Ip *
		}
		@docsForaDoLocalhost {
			path /api/docs /api/docs/* /api/docs-json /api/docs-yaml
			not host localhost 127.0.0.1
		}
		respond @docsPelaCloudflare 404
		respond @docsForaDoLocalhost 404

		reverse_proxy backend:3000
	}

	# Reservado para o gateway do chatbot (TCC-022); o Caddy já encaminha WebSocket.
	handle /socket.io/* {
		reverse_proxy backend:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@spa not path /assets/* /api/* /socket.io/*
	header @spa Cache-Control "no-cache"
}
